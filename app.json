{
  "expo": {
    "name": "Rebix",
    "slug": "rebix",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "rebix",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.rebix.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Allow Rebix to use your location to find listings in your district.",
        "NSCameraUsageDescription": "Allow Rebix to access your camera to add photos to your listings.",
        "NSPhotoLibraryUsageDescription": "Allow Rebix to access your photos to add images to your listings."
      }
    },
    "android": {
      "package": "com.rebix.app",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#1B4332",
          "image": "./assets/images/splash-slogan.png",
          "imageWidth": 220
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow Rebix to use your location to find listings in your district."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Rebix to access your photos to add images to your listings.",
          "cameraPermission": "Allow Rebix to access your camera to add photos to your listings."
        }
      ],
      [
        "expo-notifications",
        {
          "sounds": []
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "4af1b99b-720f-4868-80e5-f720213d798d"
      }
    },
    "owner": "vigneshticktix"
  }
}
